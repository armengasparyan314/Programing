# Ընտրում ենք Python-ի թեթև աշխատանքային տարբերակը
FROM python:3.10-slim

# Սահմանում ենք աշխատանքային պանակը կոնտեյների ներսում
WORKDIR /app

# Նախապես տեղադրում ենք համակարգային անհրաժեշտ գրադարաններ, եթե պահանջվեն
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Տեղափոխում ենք պահանջվող ֆայլերը կոնտեյներ
# (Համոզվիր, որ requirements.txt ունես, կամ ուղղակի տեղափոխում ենք main.py-ն ու մոդելը)
COPY requirements.txt .

# Տեղադրում ենք Python գրադարանները
RUN pip install --no-cache-dir -r requirements.txt

# Տեղափոխում ենք մնացած ֆայլերը (main.py, ensemble_package.pkl)
COPY . .

# Բացում ենք պորտը
EXPOSE 8000

# Հրաման սերվերը գործարկելու համար
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]

# Որպես հիմք օգտագործել ենք python:3.10-slim տարբերակը, որը թեթև է,
# չի պարունակում ավելորդ համակարգային ֆայլեր և ապահովում է արագ աշխատանք։
# Ստեղծել ենք /app աշխատանքային պանակը կոնտեյների ներսում։ 
# Նախ տեղադրել ենք requirements.txt-ը և գրադարանները (pip install), 
# ինչը թույլ է տալիս Docker-ին օպտիմալ կերպով օգտագործել կեշավորումը (caching),
# և միայն դրանից հետո ենք տեղափոխել մնացած ֆայլերը (COPY . ., ներառյալ main.py-ն և մոդելի .pkl ֆայլը)։
# Բացել ենք 8000-րդ պորտը (EXPOSE 8000) և սահմանել հրաման (CMD), 
# որը կոնտեյների գործարկման պահին ավտոմատ միացնում է FastAPI սերվերը Uvicorn-ի միջոցով 
# (0.0.0.0 հոսթով, որպեսզի հասանելի լինի դրսից)։